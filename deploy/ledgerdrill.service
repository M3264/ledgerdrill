[Unit]
Description=LedgerDrill Stellar testnet failure lab
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/ledgerdrill
ExecStart=/home/ubuntu/ledgerdrill/ledgerdrill -addr 127.0.0.1:8098 -data /home/ubuntu/ledgerdrill/data
Environment=GOMEMLIMIT=128MiB
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/ledgerdrill/data
UMask=0077
MemoryMax=192M

[Install]
WantedBy=multi-user.target
